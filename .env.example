# Application
APP_NAME=AI Chatbot Cloud
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=chatbot_db
DATABASE_URL=postgresql+asyncpg://chatbot:change-me-strong-password@postgres:5432/chatbot_db

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_base

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# LLM (optional - uses retrieval-only fallback if not set)
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
USE_OPENAI=false

# CORS
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploads

# Frontend build
VITE_API_URL=/api

# Copy this file to backend/.env when running without Docker.
APP_NAME=AI Knowledge Assistant
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-this-with-a-long-random-local-secret

DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db
CHROMA_MODE=local
CHROMA_PATH=./data/chroma

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USE_OPENAI=false
OPENAI_API_KEY=
